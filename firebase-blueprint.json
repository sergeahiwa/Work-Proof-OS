{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Professional credibility profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "avatar": { "type": "string" },
        "impactScore": { "type": "number" },
        "marketTrustIndex": { "type": "number" },
        "topSkills": { "type": "array", "items": { "type": "string" } },
        "aiSummary": { "type": "string" },
        "identityStatus": { "type": "string", "enum": ["verified", "unverified"] },
        "trustRegime": { "type": "string", "enum": ["TRUSTED", "UNCERTAIN", "RISKY"] },
        "anomalyScore": { "type": "number" },
        "tenantId": { "type": "string" }
      },
      "required": ["uid", "name", "role", "tenantId"]
    },
    "Project": {
      "title": "Project",
      "description": "A professional project or mission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "role": { "type": "string" },
        "impact": { "type": "string" },
        "status": { "type": "string", "enum": ["completed", "in_progress"] },
        "date": { "type": "string" }
      },
      "required": ["id", "userId", "title", "role"]
    },
    "Proof": {
      "title": "Verifiable Proof",
      "description": "Evidence of a professional achievement",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "tenantId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "before": { "type": "string" },
        "action": { "type": "string" },
        "result": { "type": "string" },
        "causality": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["preuve_structuree", "preuve_declaree", "en_verification", "preuve_verifiee", "rejetee"] },
        "strength": { "type": "string", "enum": ["incoherente", "faible", "moyenne", "credible"] },
        "weightedScore": { "type": "number" },
        "softSkills": { "type": "array", "items": { "type": "string" } },
        "confidenceScore": { "type": "number" },
        "verified": { "type": "boolean" },
        "verifierId": { "type": "string" },
        "verificationComment": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "tenantId", "title", "status"]
    },
    "ProofVersion": {
      "title": "Proof Version",
      "description": "A historical version of a proof",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "proofId": { "type": "string" },
        "data": { "$ref": "Proof" },
        "changedBy": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "proofId", "data", "changedBy"]
    },
    "AuditLog": {
      "title": "Audit Log",
      "description": "Trace of actions performed on a proof",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "proofId": { "type": "string" },
        "action": { "type": "string" },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "proofId", "action"]
    },
    "Attachment": {
      "title": "Attachment",
      "description": "Supporting file for a proof",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "proofId": { "type": "string" },
        "name": { "type": "string" },
        "url": { "type": "string" },
        "type": { "type": "string" },
        "size": { "type": "number" },
        "uploadedBy": { "type": "string" },
        "uploadedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "proofId", "name", "url"]
    },
    "ProofValidation": {
      "title": "Proof Validation",
      "description": "Validation from a peer, manager, or automated source",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "proofId": { "type": "string" },
        "validatorId": { "type": "string" },
        "validatorType": { "type": "string", "enum": ["peer", "manager", "client", "automated"] },
        "source": { "type": "string" },
        "status": { "type": "string", "enum": ["approved", "rejected", "pending"] },
        "comment": { "type": "string" },
        "weight": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "proofId", "validatorType", "status"]
    },
    "Anomaly": {
      "title": "Anomaly",
      "description": "Detected inconsistency or suspicious pattern",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "proofId": { "type": "string" },
        "type": { "type": "string" },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "type", "severity"]
    },
    "ProofExport": {
      "title": "Proof Export",
      "description": "Immutable export of a validated proof",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "proofId": { "type": "string" },
        "userId": { "type": "string" },
        "url": { "type": "string" },
        "hash": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "proofId", "userId", "url", "hash"]
    },
    "Contribution": {
      "title": "Key Contribution",
      "description": "A high-impact professional action",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "type": { "type": "string", "enum": ["execution", "decision", "coordination"] },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "impactScore": { "type": "number" },
        "leverageScore": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "title", "type"]
    },
    "Tenant": {
      "title": "Tenant",
      "description": "An isolated organizational group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "settings": { "type": "object" }
      },
      "required": ["id", "name", "ownerId"]
    }
  },
  "firestore": {
    "/tenants/{tenantId}": {
      "schema": "Tenant",
      "description": "Tenant group data"
    },
    "/tenants/{tenantId}/members/{userId}": {
      "schema": { "type": "object", "properties": { "role": { "type": "string" }, "joinedAt": { "type": "string" } } },
      "description": "Tenant membership"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile data"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/users/{userId}/proofs/{proofId}": {
      "schema": "Proof",
      "description": "Verifiable proofs for a user"
    },
    "/users/{userId}/proofs/{proofId}/versions/{versionId}": {
      "schema": "ProofVersion",
      "description": "Historical versions of a proof"
    },
    "/users/{userId}/proofs/{proofId}/attachments/{attachmentId}": {
      "schema": "Attachment",
      "description": "Supporting files for a proof"
    },
    "/users/{userId}/proofs/{proofId}/validations/{validationId}": {
      "schema": "ProofValidation",
      "description": "Multi-source validations for a proof"
    },
    "/anomalies/{anomalyId}": {
      "schema": "Anomaly",
      "description": "Global anomalies log"
    },
    "/exports/{exportId}": {
      "schema": "ProofExport",
      "description": "Immutable proof certificates"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Global audit logs"
    },
    "/users/{userId}/contributions/{contributionId}": {
      "schema": "Contribution",
      "description": "Key contributions for a user"
    }
  }
}
