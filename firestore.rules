rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /tenants/{tenantId}
    // Fields:
    //   - name: string (required) - Tenant name
    //   - ownerId: string (required) - Owner's UID
    //
    // Collection: /tenants/{tenantId}/members/{userId}
    // Fields:
    //   - role: string (optional) - member/admin
    //
    // Collection: /users/{userId}
    // Fields:
    //   - uid: string (required) - User's unique ID
    //   - name: string (required) - Full name
    //   - role: string (required) - Professional role
    //   - tenantId: string (required) - ID of the tenant the user belongs to
    //   - avatar: string (optional) - Avatar URL
    //   - impactScore: number (optional) - Impact score
    //   - marketTrustIndex: number (optional) - Trust index
    //   - topSkills: list (optional) - List of skills
    //   - aiSummary: string (optional) - AI summary
    //   - identityStatus: string (optional) - verified/unverified
    //
    // Collection: /users/{userId}/proofs/{proofId}
    // Fields:
    //   - id: string (required) - Proof ID
    //   - userId: string (required) - Owner ID
    //   - title: string (required) - Proof title
    //   - description: string (optional) - Proof description
    //   - type: string (required) - Proof type
    //   - url: string (optional) - Proof URL
    //   - confidenceScore: number (optional) - Confidence score
    //   - verified: boolean (optional) - Verification status
    //   - date: string (optional) - Date of proof
    //
    // Collection: /users/{userId}/contributions/{contributionId}
    // Fields:
    //   - id: string (required) - Contribution ID
    //   - userId: string (required) - Owner ID
    //   - type: string (required) - execution/decision/coordination
    //   - title: string (required) - Contribution title
    //   - description: string (optional) - Contribution description
    //   - impactScore: number (optional) - Impact score
    //   - leverageScore: number (optional) - Leverage score
    //   - timestamp: string (optional) - Timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
         (request.auth.token.email == "ndepoahiwa@gmail.com" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.role is string && data.role.size() > 0 && data.role.size() < 100 &&
             data.tenantId is string && data.tenantId.size() > 0 &&
             (!('avatar' in data) || (data.avatar is string && data.avatar.size() < 500));
    }

    function fieldUnchanged(field) {
      return !(field in request.resource.data) || request.resource.data[field] == resource.data[field];
    }

    function isValidProof(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.status in ["preuve_structuree", "preuve_declaree", "en_verification", "preuve_verifiee", "rejetee"];
    }

    function isValidVersion(data) {
      return data.proofId is string && data.changedBy == request.auth.uid;
    }

    function isValidAttachment(data) {
      return data.name is string && data.name.size() > 0 && 
             data.url is string && data.url.size() > 0;
    }

    function isValidAuditLog(data) {
      return data.userId == request.auth.uid && data.action is string;
    }

    function isValidContribution(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() < 200 &&
             data.type in ['execution', 'decision', 'coordination'];
    }

    function isMemberOfTenant(tenantId) {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid);
    }

    function isTenantOwner(tenantId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/tenants/$(tenantId)).data.ownerId == request.auth.uid;
    }

    function isValidTenant(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.ownerId == request.auth.uid;
    }

    function isValidLog(data) {
      return data.moduleId is string && data.moduleId.size() > 0 &&
             data.intent is string && data.intent.size() > 0 &&
             data.metrics is map &&
             data.metrics.latency is number &&
             data.metrics.confidence is number;
    }

    function isValidVector(data) {
      return data.userId is string && data.proofId is string && data.vector is list && data.vector.size() > 0;
    }

    function isValidEmbeddingLog(data) {
      return data.type in ["EMBEDDING_GENERATION", "SIMILARITY_QUERY", "INDEXATION"] &&
             data.entityId is string && data.status in ["SUCCESS", "FAIL"];
    }

    function isValidShadowMetric(data) {
      return data.metricType is string && data.value is map;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /tenants/{tenantId} {
      allow read: if isAuthenticated() && (isMemberOfTenant(tenantId) || isAdmin());
      allow create: if isAuthenticated() && isValidTenant(request.resource.data) && 
                      request.resource.data.id == tenantId &&
                      request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() && (isTenantOwner(tenantId) || isAdmin()) &&
                      fieldUnchanged('ownerId') && fieldUnchanged('createdAt') && fieldUnchanged('id');
      
      match /members/{memberId} {
        allow read: if isAuthenticated() && (isMemberOfTenant(tenantId) || isAdmin());
        allow create: if isAuthenticated() && (isTenantOwner(tenantId) || memberId == request.auth.uid);
        allow delete: if isAuthenticated() && (isTenantOwner(tenantId) || memberId == request.auth.uid || isAdmin());
      }

      match /logs/{logId} {
        allow read: if isAuthenticated() && (isMemberOfTenant(tenantId) || isAdmin());
        allow create: if isAuthenticated() && (isMemberOfTenant(tenantId) || isAdmin()) && isValidLog(request.resource.data);
      }
    }

    function isValidValidation(data) {
      return data.validatorType in ['peer', 'manager', 'client', 'automated'] &&
             data.status in ['approved', 'rejected', 'pending'] &&
             data.weight is number;
    }

    function isValidAnomaly(data) {
      return data.severity in ['low', 'medium', 'high', 'critical'] &&
             data.type is string;
    }

    function isValidExport(data) {
      return data.proofId is string && data.userId is string && data.url is string && data.hash is string;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || (resource.data.tenantId != null && isMemberOfTenant(resource.data.tenantId)) || isAdmin());
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.tenantId == 'default_tenant' || isMemberOfTenant(request.resource.data.tenantId));
      allow update: if (isOwner(userId) && isValidUser(request.resource.data) && 
                      fieldUnchanged('tenantId') && fieldUnchanged('uid') && fieldUnchanged('createdAt') &&
                      (request.resource.data.tenantId == 'default_tenant' || isMemberOfTenant(request.resource.data.tenantId))) || isAdmin();
      allow delete: if isAdmin();

      match /projects/{projectId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isMemberOfTenant(get(/databases/$(database)/documents/users/$(userId)).data.tenantId) || isAdmin());
        allow create: if isOwner(userId);
        allow update: if isOwner(userId) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /proofs/{proofId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isMemberOfTenant(get(/databases/$(database)/documents/users/$(userId)).data.tenantId) || isAdmin());
        allow create: if isOwner(userId) && isValidProof(request.resource.data);
        allow update: if (isOwner(userId) && isValidProof(request.resource.data)) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();

        match /versions/{versionId} {
          allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
          allow create: if isOwner(userId) && isValidVersion(request.resource.data);
        }

        match /attachments/{attachmentId} {
          allow read: if isAuthenticated() && (isOwner(userId) || isMemberOfTenant(get(/databases/$(database)/documents/users/$(userId)).data.tenantId) || isAdmin());
          allow create: if isOwner(userId) && isValidAttachment(request.resource.data);
          allow delete: if isOwner(userId) || isAdmin();
        }

        match /validations/{validationId} {
          allow read: if isAuthenticated() && (isOwner(userId) || isMemberOfTenant(get(/databases/$(database)/documents/users/$(userId)).data.tenantId) || isAdmin());
          allow create: if isAuthenticated() && isValidValidation(request.resource.data) && !isOwner(userId);
        }
      }

      match /contributions/{contributionId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isMemberOfTenant(get(/databases/$(database)/documents/users/$(userId)).data.tenantId) || isAdmin());
        allow create: if isOwner(userId) && isValidContribution(request.resource.data);
        allow update: if (isOwner(userId) && isValidContribution(request.resource.data)) || isAdmin();
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /audit_logs/{logId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAuditLog(request.resource.data);
    }

    match /anomalies/{anomalyId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && isValidAnomaly(request.resource.data);
    }

    match /exports/{exportId} {
      allow read: if true; // Publicly verifiable
      allow create: if isAuthenticated() && isValidExport(request.resource.data);
    }

    // ===============================================================
    // Semantic Layer Rules (Bloc 3)
    // ===============================================================

    match /proof_vectors/{vectorId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isMemberOfTenant(get(/databases/$(database)/documents/users/$(resource.data.userId)).data.tenantId) || isAdmin());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId) && isValidVector(request.resource.data);
      allow update, delete: if false; // Immutable vectors
    }

    match /embedding_logs/{logId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isAdmin());
      allow create: if isAuthenticated() && isValidEmbeddingLog(request.resource.data);
    }

    match /embedding_shadow_metrics/{metricId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isValidShadowMetric(request.resource.data);
    }

    // ===============================================================
    // Reality Intelligence Layer (RIL v1.0) Rules
    // ===============================================================

    match /reality_signals/{signalId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /proof_suggestions/{suggestionId} {
      allow read, update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
